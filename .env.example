# Paper-only mode: this bot never submits Binance orders.
# Replit injects DATABASE_URL; do not put credentials in this file.

# Pairs to scan, comma-separated.
WATCHLIST=SOLUSDT,FETUSDT,MAVUSDT,DASHUSDT,SUIUSDT,ZENUSDT,ZECUSDT

# Fixed paper allocation. The code enforces a maximum of $10 per position
# and $30 total exposure.
TRADE_QUOTE_AMOUNT=10
MAX_TOTAL_EXPOSURE=30
MAX_OPEN_POSITIONS=3

# Signal candles must be confirmed by the latest matching 15m higher-timeframe
# Confirm-only WAIT-flow signal. The higher timeframe is fixed at 15m.
TIMEFRAME=5m
HTF_TIMEFRAME=15m

# Polling interval in seconds.
SCAN_POLL_SECONDS=5

# Local health endpoint. The Replit workflow may set PORT.
BOT_HOST=0.0.0.0
BOT_PORT=8000
DATABASE_URL=sqlite:///trading.db